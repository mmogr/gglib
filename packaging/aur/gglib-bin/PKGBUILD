# Rendered by scripts/render_aur.sh, which fills in pkgver and the checksum
# from the release's SHA256SUMS. Edit this template in the gglib repository,
# not the copy on the AUR: each stable release overwrites that copy.
pkgname=gglib-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc='Local model runtime and OpenAI-compatible proxy for llama.cpp (CLI)'
arch=('x86_64')
url='https://github.com/mmogr/gglib'
license=('AGPL-3.0-only')
depends=('glibc' 'gcc-libs' 'alsa-lib')
provides=('gglib')
conflicts=('gglib')
source=("gglib-${pkgver}-x86_64-unknown-linux-gnu.tar.gz::${url}/releases/download/v${pkgver}/gglib-${pkgver}-x86_64-unknown-linux-gnu.tar.gz")
sha256sums=('@SHA256_CLI_TARBALL@')

package() {
  install -Dm755 gglib "${pkgdir}/usr/bin/gglib"
}
