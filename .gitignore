daemon.lock

# KV cache slot files (--cache/--slot-dir runtime state)
/slots

# llama.cpp local installation
/.llama
/downloads

# Web UI build output
/web_ui

# Python
.venv/
venv/
.python/
# Legacy location of the managed hf_xet environment, still present on installs
# that predate the rename.
.conda/
.gglib-runtime/
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Node.js
# No trailing slash: `node_modules/` matches a directory but not a *symlink*
# of that name, which is how one got committed in #727.
node_modules
# package-lock.json is tracked: it is what makes `npm ci` reproducible, and it
# is the only thing that pins the minimatch@3 / brace-expansion resolution
# documented in package.json's "//overrides" note.
yarn.lock
.pnpm-debug.log
npm-debug.log*

# Playwright MCP browser automation
.playwright-mcp/

# OS files
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# IDE
.idea/
*.iml

# Coverage reports
coverage/
lcov.info
tarpaulin-report.html
*.profraw
*.profdata

# Local environment overrides
.env
boundary-status.json
.vscode/settings.json
logs/
