{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "🛠️ Full Setup (make setup)",
			"type": "shell",
			"command": "make",
			"args": ["setup"],
			"group": "build",
			"problemMatcher": [],
			"presentation": { "reveal": "always", "panel": "shared", "focus": true, "clear": true }
		},
		{
			"label": "🚀 Build (Release)",
			"type": "shell",
			"command": "make",
			"args": ["build"],
			"group": { "kind": "build", "isDefault": true },
			"problemMatcher": ["$rustc"],
			"presentation": { "reveal": "always", "panel": "shared", "focus": false, "clear": true }
		},
		{
			"label": "🔨 Build (Debug)",
			"type": "shell",
			"command": "make",
			"args": ["build-dev"],
			"group": "build",
			"problemMatcher": ["$rustc"],
			"presentation": { "reveal": "always", "panel": "shared", "focus": false, "clear": true }
		},
		{
			"label": "📋 Check (Fast Compile Check)",
			"type": "shell",
			"command": "make",
			"args": ["check"],
			"group": "build",
			"problemMatcher": ["$rustc"],
			"presentation": { "reveal": "always", "panel": "shared", "focus": false, "clear": true }
		},
		{
			"label": "🎨 Build Frontend",
			"type": "shell",
			"command": "make",
			"args": ["build-gui"],
			"group": "build",
			"problemMatcher": ["$tsc"],
			"presentation": { "reveal": "always", "panel": "shared", "focus": false, "clear": true }
		},
		{
			"label": "🖥️ Build GUI (Release)",
			"type": "shell",
			"command": "make",
			"args": ["build-tauri"],
			"group": "build",
			"problemMatcher": ["$rustc"],
			"presentation": { "reveal": "always", "panel": "shared", "focus": false, "clear": true }
		},
		{
			"label": "📦 Install Binary",
			"type": "shell",
			"command": "make",
			"args": ["install"],
			"group": "none",
			"dependsOn": ["🚀 Build (Release)"],
			"problemMatcher": [],
			"presentation": { "reveal": "always", "panel": "shared", "focus": false, "clear": true }
		},
		{
			"label": "🧪 Run All Tests",
			"type": "shell",
			"command": "make",
			"args": ["test"],
			"group": { "kind": "test", "isDefault": true },
			"problemMatcher": ["$rustc"],
			"presentation": { "reveal": "always", "panel": "shared", "focus": false, "clear": true }
		},
		{
			"label": "🧪 Run Frontend Tests",
			"type": "shell",
			"command": "make",
			"args": ["test-web"],
			"group": "test",
			"problemMatcher": [],
			"presentation": { "reveal": "always", "panel": "shared", "focus": false, "clear": true }
		},
		{
			"label": "🎨 Format Code",
			"type": "shell",
			"command": "make",
			"args": ["fmt"],
			"group": "none",
			"problemMatcher": [],
			"presentation": { "reveal": "always", "panel": "shared", "focus": false, "clear": true }
		},
		{
			"label": "📎 Clippy (Strict)",
			"type": "shell",
			"command": "make",
			"args": ["lint"],
			"group": "none",
			"problemMatcher": ["$rustc"],
			"presentation": { "reveal": "always", "panel": "shared", "focus": false, "clear": true }
		},
		{
			"label": "🔒 Check Boundaries",
			"type": "shell",
			"command": "make",
			"args": ["boundaries"],
			"group": "none",
			"problemMatcher": [],
			"presentation": { "reveal": "always", "panel": "shared", "focus": false, "clear": true }
		},
		{
			"label": "🔒 Architecture Checks (make enforce)",
			"type": "shell",
			"command": "make",
			"args": ["enforce"],
			"group": "none",
			"problemMatcher": [],
			"presentation": { "reveal": "always", "panel": "shared", "focus": false, "clear": true }
		},
		{
			"label": "🔗 Regenerate Bindings (make bindings)",
			"type": "shell",
			"command": "make",
			"args": ["bindings"],
			"group": "none",
			"problemMatcher": ["$rustc"],
			"presentation": { "reveal": "always", "panel": "shared", "focus": false, "clear": true }
		},
		{
			"label": "📚 Generate Documentation",
			"type": "shell",
			"command": "make",
			"args": ["doc"],
			"group": "none",
			"problemMatcher": ["$rustc"],
			"presentation": { "reveal": "always", "panel": "shared", "focus": false, "clear": true }
		},
		{
			"label": "✅ Pre-commit Check (make pre-commit)",
			"type": "shell",
			"command": "make",
			"args": ["pre-commit"],
			"group": "none",
			"problemMatcher": ["$rustc"],
			"presentation": { "reveal": "always", "panel": "shared", "focus": true, "clear": true }
		},
		{
			"label": "🧹 Clean Build Artifacts",
			"type": "shell",
			"command": "make",
			"args": ["clean"],
			"group": "none",
			"problemMatcher": [],
			"presentation": { "reveal": "always", "panel": "shared", "focus": false, "clear": true }
		},
		{
			"label": "🧹 Clean All (Backend + Frontend)",
			"type": "shell",
			"command": "make",
			"args": ["clean", "clean-gui"],
			"group": "none",
			"problemMatcher": [],
			"presentation": { "reveal": "always", "panel": "shared", "focus": false, "clear": true }
		},
		{
			"label": "🌐 Open Web UI (make run-web)",
			"type": "shell",
			"command": "make",
			"args": ["run-web"],
			"group": "none",
			"dependsOn": ["🎨 Build Frontend"],
			"problemMatcher": ["$rustc"],
			"presentation": { "reveal": "always", "panel": "shared", "focus": false, "clear": true }
		},
		{
			"label": "📥 Install Frontend Dependencies",
			"type": "shell",
			"command": "npm",
			"args": ["install"],
			"group": "none",
			"problemMatcher": [],
			"presentation": { "reveal": "always", "panel": "shared", "focus": false, "clear": true }
		},
		{
			"label": "🎨 Run Frontend Dev",
			"type": "shell",
			"command": "npm",
			"args": ["run", "dev"],
			"isBackground": true,
			"group": "none",
			"dependsOn": ["📥 Install Frontend Dependencies"],
			"problemMatcher": {
				"pattern": {
					"regexp": "^([^\\s].*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
					"file": 1,
					"line": 2,
					"column": 3,
					"severity": 4,
					"message": 5
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": ".",
					"endsPattern": "Local:.*http"
				}
			},
			"presentation": { "reveal": "always", "panel": "shared", "focus": false, "clear": true }
		},
		{
			"label": "🧠 Run Backend Dev (API-only)",
			"type": "shell",
			"command": "cargo",
			"args": ["run", "--package", "gglib-cli", "--", "daemon", "run"],
			"isBackground": true,
			"group": "none",
			"problemMatcher": [],
			"presentation": { "reveal": "always", "panel": "shared", "focus": false, "clear": true }
		},
		{
			"label": "🚀 Run Dev (Frontend + Backend)",
			"dependsOn": ["🎨 Run Frontend Dev", "🧠 Run Backend Dev (API-only)"],
			"dependsOrder": "parallel",
			"group": "none",
			"problemMatcher": [],
			"presentation": { "reveal": "always", "panel": "shared", "focus": false, "clear": true }
		},
		{
			"label": "🖥️ Run GUI (Dev)",
			"type": "shell",
			"command": "npm",
			"args": ["run", "tauri:dev"],
			"isBackground": true,
			"group": "none",
			"dependsOn": ["📥 Install Frontend Dependencies"],
			"problemMatcher": ["$rustc"],
			"presentation": { "reveal": "always", "panel": "shared", "focus": false, "clear": true }
		},
		{
			"label": "🧪 Release Dry Run (build, publish nothing)",
			"detail": "Builds every platform exactly like a real release, tags nothing. Use before bumping the version.",
			"type": "shell",
			"command": "gh workflow run release.yml -f test_run=true && echo 'Dispatched — waiting for the run to register…' && sleep 8 && gh run watch \"$(gh run list --workflow=release.yml --limit 1 --json databaseId --jq '.[0].databaseId')\"",
			"group": "none",
			"problemMatcher": [],
			"presentation": { "reveal": "always", "panel": "shared", "focus": true, "clear": true }
		},
		{
			"label": "📥 Fetch Dry Run Artifacts",
			"detail": "Downloads the last dry run's binaries and installers into target/dry-run/ so you can install and run them.",
			"type": "shell",
			"command": "gh run download \"$(gh run list --workflow=release.yml --limit 1 --json databaseId --jq '.[0].databaseId')\" --pattern 'dryrun-*' --dir target/dry-run && echo '' && echo 'Artifacts in target/dry-run/:' && find target/dry-run -type f",
			"group": "none",
			"problemMatcher": [],
			"presentation": { "reveal": "always", "panel": "shared", "focus": true, "clear": true }
		},
		{
			"label": "🚦 Release Pre-flight (dry run + fetch)",
			"detail": "The whole loop: build a real release without tagging, then pull the artifacts down. Install them before you bump the version.",
			"dependsOn": ["🧪 Release Dry Run (build, publish nothing)", "📥 Fetch Dry Run Artifacts"],
			"dependsOrder": "sequence",
			"group": "none",
			"problemMatcher": [],
			"presentation": { "reveal": "always", "panel": "shared", "focus": true, "clear": true }
		},
		{
			"label": "🔬 Rust Coverage (lcov)",
			"type": "shell",
			"command": "$HOME/.cargo/bin/cargo llvm-cov --workspace --exclude gglib-tauri --exclude gglib-app --lcov --output-path lcov.info",
			"options": { "env": { "MACOSX_DEPLOYMENT_TARGET": "14.0" } },
			"group": "test",
			"problemMatcher": ["$rustc"],
			"presentation": { "reveal": "always", "panel": "shared", "focus": false, "clear": true }
		},
		{
			"label": "🔬 Rust Coverage (table)",
			"type": "shell",
			"command": "$HOME/.cargo/bin/cargo llvm-cov --workspace --exclude gglib-tauri --exclude gglib-app",
			"options": { "env": { "MACOSX_DEPLOYMENT_TARGET": "14.0" } },
			"group": "test",
			"problemMatcher": ["$rustc"],
			"presentation": { "reveal": "always", "panel": "shared", "focus": true, "clear": true }
		},
		{
			"label": "🔬 Rust Coverage (html)",
			"type": "shell",
			"command": "$HOME/.cargo/bin/cargo llvm-cov --workspace --exclude gglib-tauri --exclude gglib-app --html --output-dir coverage && open coverage/html/index.html",
			"options": { "env": { "MACOSX_DEPLOYMENT_TARGET": "14.0" } },
			"group": "test",
			"problemMatcher": ["$rustc"],
			"presentation": { "reveal": "always", "panel": "shared", "focus": false, "clear": true }
		}
	]
}
