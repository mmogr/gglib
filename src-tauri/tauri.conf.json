{
  "productName": "GGLib GUI",
  "identifier": "com.gglib.gui",
  "build": {
    "beforeBuildCommand": "npm run build:tauri",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../web_ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GGLib \u2014 Local Model Runtime",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      },
      {
        "label": "tray",
        "title": "gglib Proxy",
        "url": "tray.html",
        "width": 360,
        "height": 480,
        "resizable": false,
        "decorations": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "copyright": "Copyright \u00a9 2025-2026 mmogr",
    "externalBin": [],
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [],
    "shortDescription": "Desktop app for gglib, a local model runtime for llama.cpp",
    "longDescription": "Download GGUF models, run them with llama.cpp and chat with them, all on your own machine. The desktop app for gglib.",
    "macOS": {
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "10.13"
    }
  }
}
